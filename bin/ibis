#!/usr/bin/env bash
# ibis — graph-driven coordination for any repo.
#
# Humans run init. AI agents and hooks do the rest.
# The graph (.ibis/GRAPH.dot) IS the system: nodes carry check=, doc=,
# test=, restart=. Hooks enforce the workflow. The scheduler runs checks
# and drains the message bus into HANDOFF.md automatically.
#
# Setup (human, once):
#   ibis init [--adopt] [--no-units]   scaffold + auto-discover + hooks + scheduler
#
# For AI agents (CLAUDE.md tells them when):
#   ibis node <name> --context         everything before acting: graph + doc + recovery + priorities
#   ibis node <name> [--depth N]       node definition + edges
#   ibis notify <message>              describe what you're about to do (pre-commit enforces)
#   ibis claim <node> [--ttl N]        lease a node so other sessions don't collide
#   ibis release <node> [--force]      release your lease
#   ibis ledger <node> [value] [note]  prove the fix with a measurement
#   ibis status [--all]                check health now
#
# Automatic (hooks + scheduler):
#   ibis poll [--drain-only]           checks + bus drain (systemd timer, every 2 min)
#   ibis hook <install|uninstall>      git hooks: notify enforcement, doc-drift, audit
#   ibis doctor [--strict]             structure gate (CI)
#   ibis audit [--strict] [--no-run]   honesty gate (CI)
#   ibis validate [--node X] [--json]  reference gate (CI)
#
# Other:
#   ibis render [--open]               graph visualization
#   ibis hub <sub>                     multi-repo coordinator
#   ibis mcp [--read-only]             MCP server for any AI agent
#   ibis who                           active leases
#   ibis stamp [<node>|--all]          re-stamp docs after review
set -uo pipefail

# ibis uses associative arrays — needs bash >= 4. macOS ships bash 3.2; fix with
# `brew install bash` (env will then pick up the newer one).
if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  echo "ibis needs bash >= 4 (found ${BASH_VERSION:-unknown}). macOS: brew install bash" >&2
  exit 1
fi

# Resolve this script's real dir, following symlinks (install.sh symlinks us onto
# PATH). BSD has no `readlink -f`, so walk the symlink chain by hand.
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
IBIS_HOME="$(cd -P "$(dirname "$_src")/.." && pwd)"
export IBIS_HOME

# shellcheck source=/dev/null
source "$IBIS_HOME/lib/common.sh"
source "$IBIS_HOME/lib/scheduler.sh"
for f in discover addnode init poll status doctor audit validate hub claim hook ledger notify node render; do
  source "$IBIS_HOME/lib/cmd_$f.sh"
done

ibis_help() {
  # Print the leading comment block (skip the shebang, stop at first code line).
  awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$IBIS_HOME/bin/ibis"
}

# Commands that operate on a repo set their own paths; init/discover call
# set_paths themselves. For the rest we set paths up front.
cmd="${1:-help}"; shift || true
case "$cmd" in
  init)      ibis_init "$@";;
  discover)  ibis_discover "$@";;
  add-node)  set_paths; ibis_add_node "$@";;
  poll)      set_paths; ibis_poll "$@";;
  status)    set_paths; ibis_status "$@";;
  doctor)    set_paths; ibis_doctor "$@";;
  audit)     set_paths; ibis_audit "$@";;
  audit-log) set_paths; ibis_audit_log "$@";;
  validate)  set_paths; ibis_validate "$@";;
  stamp)     set_paths; ibis_stamp "$@";;
  ledger)    set_paths; ibis_ledger "$@";;
  notify)    set_paths; ibis_notify "$@";;
  whoami)    worker_id;;
  claim)     set_paths; ibis_claim "$@";;
  release)   set_paths; ibis_release "$@";;
  who|claims) set_paths; ibis_who "$@";;
  node)      set_paths; ibis_node "$@";;
  render)    set_paths; ibis_render "$@";;
  hub)       ibis_hub "$@";;
  hook)      ibis_hook "$@";;
  guard)     set_paths; ibis_hook guard "$@";;
  mcp)       set_paths; IBIS_MCP_REPO="$REPO_ROOT" exec "$PYTHON" "$IBIS_HOME/lib/mcp_server.py" "$@";;
  install-scheduler)
    set_paths; require_init
    install_scheduler "$(project_name)" "$(project_id)";;
  uninstall-scheduler)
    set_paths
    uninstall_scheduler "$(project_id)";;
  project)
    set_paths; project_name;;
  -h|--help|help) ibis_help;;
  version|--version) echo "ibis 0.1.0";;
  *) err "unknown command: $cmd"; ibis_help; exit 2;;
esac
