#!/usr/bin/env bash
# ibis — graph-driven coordination for any repo.
# The graph (.ibis/GRAPH.dot) IS the system: nodes carry check=, doc=, test=,
# restart=. ibis polls the checks, drains a fire-and-forget message bus into
# HANDOFF.md, and enforces that every node has a check, a doc, and a test.
#
#   ibis init [--adopt] [--no-units]   scaffold + auto-discover + install timers
#   ibis discover                      list candidate nodes from repo structure
#   ibis add-node <name> --check '…'   add a node (creates doc + test stubs)
#   ibis poll [--drain-only]           run checks + drain bus (used by systemd)
#   ibis status [--all]                run checks now, report pass/fail
#   ibis doctor [--strict]             enforce check+doc+test on every node (CI)
#   ibis audit [--strict] [--no-run]   prove docs are true (assertions) + fresh (stamps)
#   ibis validate [--node X] [--json]  prove metadata refs resolve to real files
#   ibis stamp [<node>|--all]          (re)stamp docs after reviewing them
#   ibis ledger <node> [value] [note]  record / show a node's measured trend
#   ibis notify <message>              drop a message on the bus (attributed to IBIS_WORKER)
#   ibis project                       print this project's name (.ibis/config or dir)
#   ibis whoami                        print this worker's id (IBIS_WORKER or user@host)
#   ibis claim <node> [--ttl N]        lease a node so other workers don't collide
#   ibis release <node> [--force]      release your lease
#   ibis who                           active claims in this repo (expired ones swept)
#   ibis hub <init|add|poll|who|…>     coordinator: aggregate many repos into one HANDOFF
#   ibis hook <install|uninstall>      git hook: keep .ibis/GRAPH.dot in sync with commits
#   ibis mcp [--read-only]             stdio MCP server — coordination for any MCP agent
#   ibis install-scheduler             (re)install the timer + instant-drain watcher
#   ibis uninstall-scheduler           remove this repo's scheduler
set -uo pipefail

# ibis uses associative arrays — needs bash >= 4. macOS ships bash 3.2; fix with
# `brew install bash` (env will then pick up the newer one).
if [ -z "${BASH_VERSINFO:-}" ] || [ "${BASH_VERSINFO[0]}" -lt 4 ]; then
  echo "ibis needs bash >= 4 (found ${BASH_VERSION:-unknown}). macOS: brew install bash" >&2
  exit 1
fi

# Resolve this script's real dir, following symlinks (install.sh symlinks us onto
# PATH). BSD has no `readlink -f`, so walk the symlink chain by hand.
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
IBIS_HOME="$(cd -P "$(dirname "$_src")/.." && pwd)"
export IBIS_HOME

# shellcheck source=/dev/null
source "$IBIS_HOME/lib/common.sh"
source "$IBIS_HOME/lib/scheduler.sh"
for f in discover addnode init poll status doctor audit validate hub claim hook ledger notify; do
  source "$IBIS_HOME/lib/cmd_$f.sh"
done

ibis_help() {
  # Print the leading comment block (skip the shebang, stop at first code line).
  awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$IBIS_HOME/bin/ibis"
}

# Commands that operate on a repo set their own paths; init/discover call
# set_paths themselves. For the rest we set paths up front.
cmd="${1:-help}"; shift || true
case "$cmd" in
  init)      ibis_init "$@";;
  discover)  ibis_discover "$@";;
  add-node)  set_paths; ibis_add_node "$@";;
  poll)      set_paths; ibis_poll "$@";;
  status)    set_paths; ibis_status "$@";;
  doctor)    set_paths; ibis_doctor "$@";;
  audit)     set_paths; ibis_audit "$@";;
  validate)  set_paths; ibis_validate "$@";;
  stamp)     set_paths; ibis_stamp "$@";;
  ledger)    set_paths; ibis_ledger "$@";;
  notify)    set_paths; ibis_notify "$@";;
  whoami)    worker_id;;
  claim)     set_paths; ibis_claim "$@";;
  release)   set_paths; ibis_release "$@";;
  who|claims) set_paths; ibis_who "$@";;
  hub)       ibis_hub "$@";;
  hook)      ibis_hook "$@";;
  mcp)       set_paths; IBIS_MCP_REPO="$REPO_ROOT" exec "$PYTHON" "$IBIS_HOME/lib/mcp_server.py" "$@";;
  install-scheduler)
    set_paths; require_init
    install_scheduler "$(project_name)" "$(project_id)";;
  uninstall-scheduler)
    set_paths
    uninstall_scheduler "$(project_id)";;
  project)
    set_paths; project_name;;
  -h|--help|help) ibis_help;;
  version|--version) echo "ibis 0.1.0";;
  *) err "unknown command: $cmd"; ibis_help; exit 2;;
esac
